   "dia": 1,
   "mes": 10,
   "autor": "seward",
   "tipo": "diario",
   "capitulo": 18,
   "lugar": "m",
   "palabras": 2033,
   "inicio": "Just as we were about to leave the house, an"
  },
  {
   "dia": 1,
   "mes": 10,
   "autor": "jonathan",
   "tipo": "diario",
   "capitulo": 19,
   "lugar": "m",
   "palabras": 3003,
   "inicio": "I went with the party to the search with an easy"
  },
  {
   "dia": 1,
   "mes": 10,
   "autor": "jonathan",
   "tipo": "diario",
   "capitulo": 19,
   "lugar": "",
   "palabras": 173,
   "inicio": "I suppose it was natural that we should have all"
  },
