   "autor": "jonathan",
   "tipo": "diario",
   "capitulo": 22,
   "lugar": "",
   "palabras": 5490,
   "inicio": "As I must do something or go mad, I write this diary. It"
  },
  {
   "dia": 3,
   "mes": 10,
   "autor": "seward",
   "tipo": "diario",
   "capitulo": 23,
   "lugar": "",
   "palabras": 4304,
   "inicio": "The time seemed terribly long whilst we were waiting for"
  },
  {
   "dia": 4,
   "mes": 10,
   "autor": "jonathan",
   "tipo": "diario",
   "capitulo": 23,
   "lugar": "",
   "palabras": 1813,
   "inicio": "Once again during the night I was wakened by"
  },
  {
